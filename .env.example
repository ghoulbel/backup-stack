# Copy to .env and fill in real values. Never commit .env.

# Encrypts the repository at /mnt/synology/backup/homelab.
# If you lose this, the backup is unrecoverable. Store it in a password manager.
KOPIA_PASSWORD=change-me

# Basic-auth credentials for the KopiaUI web interface (bound to 127.0.0.1:5151).
KOPIA_SERVER_USER=kopia
KOPIA_SERVER_PASSWORD=change-me